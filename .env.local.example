# ─── Supabase ─────────────────────────────────────────────────────────────────
# Required for auth (login/register) and admin-edited content to work.
#
# Setup steps:
#   1. Create a project at https://supabase.com (free tier is fine)
#   2. Project Settings → API:
#        - "Project URL"         → NEXT_PUBLIC_SUPABASE_URL
#        - "anon / public" key   → NEXT_PUBLIC_SUPABASE_ANON_KEY
#        - "service_role" key    → SUPABASE_SERVICE_ROLE_KEY
#   3. SQL Editor → New Query → run supabase/schema.sql
#   4. Add all three vars to Vercel: Project → Settings → Environment Variables
#   5. Set your first admin: Supabase → Table Editor → profiles →
#      find your row → change role from 'pending' to 'admin'
#
NEXT_PUBLIC_SITE_URL=https://rolladelts.org
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Resend (email notifications) ──────────────────────────────────────────────
# Optional. Powers the "email me when a new lead/RSVP comes in" feature.
# Without it, leads/RSVPs still save to the database as normal — this only
# skips the email alert.
#
# Setup steps:
#   1. Create a free account at https://resend.com
#   2. API Keys → Create API Key → paste it below
#   3. (Recommended) Domains → add and verify your chapter's sending domain,
#      then update the `from` address in src/lib/email.ts away from the
#      onboarding@resend.dev sandbox address
#   4. Add RESEND_API_KEY to Vercel: Project → Settings → Environment Variables
#   5. Set a "Notification Email" in the site's Admin → Site Settings page —
#      that's who receives the alerts
#
RESEND_API_KEY=your-resend-api-key

# ─── Cloudflare Turnstile (anti-bot) ────────────────────────────────────────────
# Optional but recommended. The honeypot/JS-check anti-spam on lead forms is
# regularly defeated by headless-browser bots, which also target /register,
# /login, and /forgot-password with no protection at all. Without these vars,
# every page still works exactly as before — Turnstile just doesn't render.
#
# Setup steps:
#   1. Create a free account at https://dash.cloudflare.com/sign-up
#   2. Turnstile → Add widget → hostname rolladelts.org (and rolladelts.vercel.app
#      if you still use that), widget mode "Managed"
#   3. Copy the Site Key and Secret Key it gives you
#   4. Add both to Vercel: Project → Settings → Environment Variables
#   5. (Recommended, closes the /register + /login + /forgot-password gap too)
#      In Supabase: Authentication → Attack Protection → Bot and Abuse
#      Protection → Enable CAPTCHA protection → provider "Turnstile" → paste
#      the same Secret Key → Save. This is a single project-wide toggle that
#      covers sign-up, sign-in, and password reset together — the reason all
#      three of those pages (not just /register) already render the widget.
#
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── Removed ──────────────────────────────────────────────────────────────────
# ADMIN_USERNAME, ADMIN_PASSWORD, SESSION_SECRET are no longer used.
# Supabase Auth handles sessions and the profiles table manages roles.
